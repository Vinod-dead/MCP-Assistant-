# Only needed for `npm run dev` (frontend on :3000, API on :8000). When Studio serves the built dashboard
# itself (the normal way) leave this unset: the browser then talks to the same origin.
# NOTE: never put API keys here -- NEXT_PUBLIC_* values are visible in the browser. Keys live in the project-root .env (server only).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
