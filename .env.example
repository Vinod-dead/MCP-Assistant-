# Copy this file to .env and fill in what you need. .env is git-ignored.
# Only the variables listed per server in config/mcp_servers.json are passed to that server.

# ---- LLM (required for the real assistant; without it you get the offline demo mode) ----
# Provider order with --provider auto: NVIDIA (if NVIDIA_API_KEY is set) -> Gemini -> offline mock.
# Keys stay on the server. The Studio browser UI never receives them.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
# Run `python -m mcp_assistant.cli --list-models` to see which models your key can use.
# GEMINI_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-001
# Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Folders ----
# FILES_ROOT=./workspace          # the only folder the file tools can touch
# REPO_ROOT=.                     # repository the code tools inspect

# ---- Databases (default: bundled SQLite demo database) ----
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@localhost:5432/mydb
# DATABASE_URL=mysql+pymysql://readonly_user:password@localhost:3306/mydb

# ---- Code repositories ----
# GITHUB_TOKEN=                   # fine-grained token; needed only to create issues / read private repos

# ---- Cloud ----
# GOOGLE_CLOUD_PROJECT=my-project # then: gcloud auth application-default login
# AWS_PROFILE=default
# AZURE_STORAGE_CONNECTION_STRING=

# ---- Applications (writes are dry-run until APPS_DRY_RUN=false) ----
APPS_DRY_RUN=true
# SLACK_BOT_TOKEN=xoxb-...
# NOTION_TOKEN=ntn_...
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=             # Google app password (needs 2-step verification)
# GMAIL_ALLOWED_RECIPIENT_DOMAINS=yourcompany.com

# ---- Custom APIs ----
# API_ALLOWLIST=api.github.com,internal-api.example.com
# API_BEARER_TOKENS=api.github.com=ghp_xxx,internal-api.example.com=abc123
